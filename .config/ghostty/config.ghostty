font-family = "JetBrainsMono Nerd Font"
# background color (hex, with or without leading #)
# background = 11111B
# transparency: 0.0 (fully transparent) to 1.0 (opaque)
# 85% opacity in Terminal.app -> 0.85
# background-opacity = 0.85
# macOS blur behind the window (integer radius); set to match Terminal's blur
# background-blur-radius = 20

theme = Catppuccin Mocha

window-width = 210
window-height = 55
