{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-2",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "useAutoModeDuringPlan": true,
  "voiceEnabled": true,
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.config/claude-mods/token-weather"
  }
}
